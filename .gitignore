# Rust build output — regenerable, large, never committed.
/target/

# Detached experiment crates build their own target dirs (see experiments/).
experiments/**/target/

# Commit the workspace lockfile for reproducible engine/demo/CI verification.
# Library consumers still resolve dependencies using their own lockfiles.
experiments/**/Cargo.lock

# Compiler / editor backups.
**/*.rs.bk

# IDE directories — contributors use whatever editor they like; none of
# these belong in version control.
.idea/
.vscode/

# OS noise (Windows/macOS file-manager artifacts).
Thumbs.db
.DS_Store
